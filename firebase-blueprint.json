{
  "entities": {
    "Client": {
      "title": "客户及项目资产",
      "description": "存储客户基础信息、认知阶段 (Phase 0-7) 及决策分析数据",
      "type": "object",
      "properties": {
        "company": { "type": "string" },
        "stage": { "type": "string", "enum": ["phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "phase_5", "phase_6", "phase_7"] },
        "projectScore": { "type": "number" },
        "nextActionSuggestion": { "type": "string" },
        "nextActionCompleted": { "type": "boolean" },
        "memorySummary": { "type": "string" },
        "ownerId": { "type": "string" }
      }
    },
    "Interaction": {
      "title": "客户互动记录",
      "description": "存储与客户的对话、会议、邮件等历史互动",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["chat", "email", "meeting", "call"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "authorId": { "type": "string" }
      }
    },
    "KnowledgeEntry": {
      "title": "智慧知识库",
      "description": "存储行业洞察、竞争情报及战略战术",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["strategy", "competitor", "industry", "product", "customer_case"] },
        "ownerId": { "type": "string" }
      }
    },
    "AgentSkill": {
      "title": "Agent 技能",
      "description": "AI 认知的具象化逻辑模块",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["analysis", "generation", "strategy", "evolved"] },
        "logic": { "type": "string" },
        "usageCount": { "type": "number" },
        "performanceScore": { "type": "number" },
        "applicablePhases": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "EvolutionProposal": {
      "title": "进化提案",
      "description": "AI 自主发现的认知补丁或新技能建议",
      "type": "object",
      "properties": {
        "problem": { "type": "string" },
        "suggestedSkillName": { "type": "string" },
        "suggestedSkillDescription": { "type": "string" },
        "suggestedSkillLogic": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "implemented"] },
        "isManual": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "LLMConfig": {
      "title": "大模型引擎配置",
      "description": "存储底层大语言模型的接入参数与状态",
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["Google", "OpenAI", "Anthropic", "Custom"] },
        "modelId": { "type": "string" },
        "displayName": { "type": "string" },
        "isPrimary": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Error"] },
        "ownerId": { "type": "string" }
      }
    },
    "AgentInteraction": {
      "title": "Agent 研讨日志",
      "description": "存储战略咨询、推理过程及生成资产的历史记录",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["reasoning", "lab"] },
        "query": { "type": "string" },
        "result": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/agent_logs": {
      "schema": "AgentInteraction",
      "description": "Agent 全局研讨历史"
    },
    "/clients": {
      "schema": "Client",
      "description": "客户主集合"
    },
    "/clients/{clientId}/interactions": {
      "schema": "Interaction",
      "description": "客户互动子集合"
    },
    "/knowledge": {
      "schema": "KnowledgeEntry",
      "description": "知识资产集合"
    },
    "/skills": {
      "schema": "AgentSkill",
      "description": "Agent 技能仓库"
    },
    "/evolution_proposals": {
      "schema": "EvolutionProposal",
      "description": "系统进化提案集合"
    },
    "/llm_configs": {
      "schema": "LLMConfig",
      "description": "模型枢纽配置"
    }
  }
}
